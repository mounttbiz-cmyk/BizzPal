# AI Provider API Keys (server-only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Firebase Web App Configuration
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web (SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only: Firebase service account JSON (raw or base64). Lets superadmin delete users from Firebase Auth + Firestore.
FIREBASE_SERVICE_ACCOUNT=

# Google OAuth Credentials (Google Workspace, Google Drive, Calendar)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://bizzpal.ai
APP_URL=https://bizzpal.ai

# Microsoft Entra / OneDrive Credentials (Microsoft 365, OneDrive)
# Obtained from: Azure Portal -> App Registrations -> Web Redirect: https://bizzpal.ai/api/integrations/onedrive/callback
MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# DataPal Extraction (Google Places API New)
GEMINI_MAPS_API_KEY=

# Razorpay Payment Gateway Configuration
# Get these from your Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Admin console (REQUIRED: there is no built-in default passcode; admin login is disabled until set)
SUPERADMIN_PASSCODE=
# Optional: separate long random secret for signing admin sessions (falls back to the passcode)
ADMIN_SESSION_SECRET=

# Webhook security (endpoints answer 503 until the relevant secret is set)
STRIPE_WEBHOOK_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_TOKEN=

# --- Business verification, bank, payments, team (onboarding) ---
# Licensed data provider for the GST registry check AND the bank account-holder check (penny drop).
# Without it the app still works but shows businesses/bank accounts as "Not yet verified".
GST_API_KEY=
# GST_API_PROVIDER=surepass
# GST_API_BASE_URL=
# KYC_API_KEY=            # optional: separate key for the bank check (defaults to GST_API_KEY)
# KYC_API_BASE_URL=

# Encrypts customers' Razorpay/Stripe keys at rest. REQUIRED in production, never change it once
# set (stored keys could no longer be read). Generate with: openssl rand -base64 32
SECRETS_KEY=

# Real Google Cloud spend on the admin "DataPal Usage" page (optional).
# 1) Cloud Console -> Billing -> Billing export -> enable "Standard usage cost" export to a BigQuery dataset.
# 2) Create a service account with "BigQuery Data Viewer" on that dataset and "BigQuery Job User" on the project.
GCP_BILLING_EXPORT_TABLE=
GCP_BILLING_SERVICE_ACCOUNT=
# Total free credit you were granted, in your billing currency (lets the page work out "credits left")
GCP_CREDITS_TOTAL=

# Where the database is stored. On the VM point this OUTSIDE the app folder (e.g. /home/it/bizzpal-data)
# so deploys and reboots never touch it. Back it up with: npm run backup:db
BIZZPAL_DATA_DIR=
# Required: admin sign-in passcode and the secret that signs admin sessions (there is no default)
SUPERADMIN_PASSCODE=
ADMIN_SESSION_SECRET=
