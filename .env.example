    # AI Provider API Keys (server-only — never prefix with NEXT_PUBLIC_)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
COHERE_API_KEY=your_cohere_api_key_here

# Firebase Web App Configuration
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web (SDK setup and configuration)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Server-only: Firebase service account JSON (raw or base64). Lets superadmin delete users from Firebase Auth + Firestore.
FIREBASE_SERVICE_ACCOUNT=

# Google OAuth Credentials (Google Workspace, Google Drive, Calendar)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=https://bizzpal.ai
APP_URL=https://bizzpal.ai

# Microsoft Entra / OneDrive Credentials (Microsoft 365, OneDrive)
# Obtained from: Azure Portal -> App Registrations -> Web Redirect: https://bizzpal.ai/api/integrations/onedrive/callback
MICROSOFT_CLIENT_ID=
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# DataPal Extraction (Google Places API New)
GEMINI_MAPS_API_KEY=

# Razorpay Payment Gateway Configuration
# Get these from your Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_HERE
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Google Drive file picker (Knowledge Hub and Upload Business Data)
# Google Cloud Console -> APIs & Services:
#   1) Enable "Google Picker API" and "Google Drive API"
#   2) Credentials -> Create API key -> restrict it to "Google Picker API" and to your website addresses
#   3) The project number is on the project's Dashboard / Settings page
# Only the non-sensitive drive.file scope is used, so Google's "unverified app" warning does not appear.
GOOGLE_PICKER_API_KEY=
GOOGLE_PROJECT_NUMBER=

# Key used to encrypt third-party connection tokens (Google Drive, OneDrive, payment keys). Required on the live server.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=

# LOCAL TESTING ONLY. Lets a production build run the fake "Complete test payment" checkout when Razorpay keys are
# not set. Never set this on the live server: anyone could then get paid plans and records for free.
ALLOW_SIMULATED_PAYMENTS=
